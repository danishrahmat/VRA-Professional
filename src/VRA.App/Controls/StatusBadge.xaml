<UserControl x:Class="VRA.App.Controls.StatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        x:Name="BadgeBorder"
        Background="#1F3B2B"
        CornerRadius="12"
        Padding="10,4">

        <StackPanel Orientation="Horizontal">

            <Ellipse
                Width="8"
                Height="8"
                Fill="LimeGreen"
                VerticalAlignment="Center"/>

            <TextBlock
                Margin="8,0,0,0"
                Text="READY"
                FontWeight="SemiBold"
                FontSize="12"
                VerticalAlignment="Center"/>

        </StackPanel>

    </Border>

</UserControl>