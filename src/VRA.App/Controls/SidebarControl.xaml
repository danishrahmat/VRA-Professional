<UserControl
    x:Class="VRA.App.Controls.SidebarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VRA.App.Controls">

    <Border 
 Background="{DynamicResource SurfaceBrush}"
 CornerRadius="12"
 Padding="15">

        <StackPanel>

            <TextBlock
     Text="Navigation"
     FontSize="20"
     FontWeight="Bold"
     Margin="0,0,0,25"/>

            <controls:NavigationButton
         Title="Dashboard"
         Icon="🏠"/>

            <controls:NavigationButton
         Title="Patients"
         Icon="👤"/>

            <controls:NavigationButton
         Title="Hearing Test"
         Icon="🎧"/>

            <controls:NavigationButton
         Title="Reinforcement"
         Icon="📺"/>

            <controls:NavigationButton
         Title="Reports"
         Icon="📊"/>

            <controls:NavigationButton
         Title="Settings"
         Icon="⚙"/>
        </StackPanel>

    </Border>

</UserControl>