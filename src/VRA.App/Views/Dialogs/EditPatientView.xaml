<UserControl x:Class="VRA.App.Views.Dialogs.EditPatientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Width="700"
        Padding="30"
        Background="{DynamicResource SurfaceBrush}"
        CornerRadius="12">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- ========================= -->
            <!-- Header                    -->
            <!-- ========================= -->

            <StackPanel Grid.Row="0">

                <TextBlock
                    Text="Edit Patient"
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextBrush}"/>

                <TextBlock
                    Text="Edit patient information"
                    Margin="0,4,0,0"
                    FontSize="14"
                    Foreground="{DynamicResource TextSecondaryBrush}"/>

            </StackPanel>


            <!-- ========================= -->
            <!-- Form                      -->
            <!-- ========================= -->

            <ScrollViewer
                Grid.Row="2"
                VerticalScrollBarVisibility="Auto">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- Medical Record / IC -->
                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock
                                Text="Medical Record Number"
                                Style="{StaticResource FormLabelStyle}"/>

                            <TextBox
                                Text="{Binding MedicalRecordNumber, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource FormTextBoxStyle}"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock
                                Text="IC / Passport"
                                Style="{StaticResource FormLabelStyle}"/>

                            <TextBox
                                Text="{Binding IcPassportNumber, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource FormTextBoxStyle}"/>

                        </StackPanel>

                    </Grid>


                    <!-- First / Last Name -->
                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock
                                Text="First Name"
                                Style="{StaticResource FormLabelStyle}"/>

                            <TextBox
                                Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource FormTextBoxStyle}"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock
                                Text="Last Name"
                                Style="{StaticResource FormLabelStyle}"/>

                            <TextBox
                                Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource FormTextBoxStyle}"/>

                        </StackPanel>

                    </Grid>


                    <!-- DOB / Gender -->
                    <Grid Grid.Row="4">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock
                                Text="Date of Birth"
                                Style="{StaticResource FormLabelStyle}"/>

                            <DatePicker
                                SelectedDate="{Binding DateOfBirth}"
                                Style="{StaticResource FormDatePickerStyle}"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock
                                Text="Gender"
                                Style="{StaticResource FormLabelStyle}"/>

                            <ComboBox
                                    ItemsSource="{Binding GenderOptions}"
                                    SelectedItem="{Binding Gender}"
                                    Style="{StaticResource FormComboBoxStyle}"/>

                        </StackPanel>

                    </Grid>


                    <!-- Guardian / Phone -->
                    <Grid Grid.Row="6">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock
                                Text="Parent / Guardian"
                                Style="{StaticResource FormLabelStyle}"/>

                            <TextBox
                                Text="{Binding ParentGuardian, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource FormTextBoxStyle}"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock
                                Text="Phone Number"
                                Style="{StaticResource FormLabelStyle}"/>

                            <TextBox
                                Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource FormTextBoxStyle}"/>

                        </StackPanel>

                    </Grid>


                    <!-- Referred By -->
                    <StackPanel Grid.Row="8">

                        <TextBlock
                            Text="Referred By"
                            Style="{StaticResource FormLabelStyle}"/>

                        <TextBox
                            Text="{Binding ReferredBy, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource FormTextBoxStyle}"/>

                    </StackPanel>


                    <!-- Diagnosis -->
                    <StackPanel Grid.Row="10">

                        <TextBlock
                            Text="Diagnosis"
                            Style="{StaticResource FormLabelStyle}"/>

                        <TextBox
                            Text="{Binding Diagnosis, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource FormTextBoxStyle}"/>

                    </StackPanel>


                    <!-- Notes -->
                    <StackPanel Grid.Row="12">

                        <TextBlock
                            Text="Notes"
                            Style="{StaticResource FormLabelStyle}"/>

                        <TextBox
                            Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource FormTextBoxStyle}"
                            Height="80"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto"/>

                    </StackPanel>

                </Grid>

            </ScrollViewer>


            <!-- ========================= -->
            <!-- Actions                   -->
            <!-- ========================= -->

            <StackPanel
                Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,20,0,0">

                <Button
                    Content="Cancel"
                    Width="100"
                    Height="40"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"/>

                <Button
                    Content="Save Changes"
                    Width="130"
                    Height="40"
                    Margin="8,0,0,0"
                    Command="{Binding SavePatientCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"/>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>