<UserControl
    x:Class="VRA.App.Views.Pages.AudioSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">



    <UserControl.Resources>



        <Style x:Key="AudioDeviceComboBox"
       TargetType="{x:Type ComboBox}">

            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="MaxDropDownHeight" Value="180"/>

            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Background" Value="#3A3A3A"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="8"/>

                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#2488ED"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2488ED"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="32"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter
                                Grid.Column="0"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                IsHitTestVisible="False"/>

                                    <ToggleButton
                                Grid.Column="1"
                                Focusable="False"
                                IsChecked="{Binding IsDropDownOpen,
                                    Mode=TwoWay,
                                    RelativeSource={RelativeSource TemplatedParent}}"
                                ClickMode="Press"
                                Background="#3A3A3A"
                                BorderThickness="0"
                                Foreground="White">

                                        <TextBlock
                                    Text="▼"
                                    FontSize="10"
                                    Foreground="White"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup
                        Name="PART_Popup"
                        Placement="Bottom"
                        IsOpen="{TemplateBinding IsDropDownOpen}"
                        AllowsTransparency="True"
                        Focusable="False"
                        PopupAnimation="Fade">

                                <Border
                            Background="#292929"
                            BorderBrush="#555555"
                            BorderThickness="1"
                            MinWidth="{Binding ActualWidth,
                                RelativeSource={RelativeSource TemplatedParent}}"
                            MaxHeight="{TemplateBinding MaxDropDownHeight}">

                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>

                                </Border>
                            </Popup>

                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>


    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="20">

            <TextBlock
                Text="Audio Settings"
                FontSize="30"
                FontWeight="Bold"
                Margin="0,0,0,8"/>

            <TextBlock
                Text="Manage audio output devices for VRA reinforcement."
                Foreground="{DynamicResource SecondaryTextBrush}"
                Margin="0,0,0,20"/>

            <Border
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="10"
                Padding="20">

                <StackPanel>

                    <!-- Audio Device Assignment -->
                    <Border
    Background="{DynamicResource CardBackgroundBrush}"
    CornerRadius="10"
    Padding="20"
    Margin="0,0,0,20">

                        <StackPanel>

                            <TextBlock
            Text="Audio Device Assignment"
            FontSize="20"
            FontWeight="SemiBold"
            Margin="0,0,0,8"/>

                            <TextBlock
            Text="Assign a separate USB audio adapter to each VRA speaker."
            Opacity="0.7"
            Margin="0,0,0,16"/>

                            <TextBlock Text="LEFT Speaker" Margin="0,0,0,5"/>

                            <ComboBox
            Style="{StaticResource AudioDeviceComboBox}"
            ItemsSource="{Binding UsbAudioDevices}"
            DisplayMemberPath="Name"
            SelectedValuePath="Id"
            SelectedValue="{Binding LeftDeviceId,
                        Mode=TwoWay,
                        UpdateSourceTrigger=PropertyChanged}"
            Margin="0,0,0,14"
            Padding="8"/>

                            <TextBlock Text="CENTRE Speaker" Margin="0,0,0,5"/>

                            <ComboBox
            Style="{StaticResource AudioDeviceComboBox}"                    
            ItemsSource="{Binding UsbAudioDevices}"
            DisplayMemberPath="Name"
            SelectedValuePath="Id"
            SelectedValue="{Binding CentreDeviceId,
                        Mode=TwoWay,
                        UpdateSourceTrigger=PropertyChanged}"
            Margin="0,0,0,14"
            Padding="8"/>

                            <TextBlock Text="RIGHT Speaker" Margin="0,0,0,5"/>

                            <ComboBox
            Style="{StaticResource AudioDeviceComboBox}"                    
            ItemsSource="{Binding UsbAudioDevices}"
            DisplayMemberPath="Name"
            SelectedValuePath="Id"
            SelectedValue="{Binding RightDeviceId,
                        Mode=TwoWay,
                        UpdateSourceTrigger=PropertyChanged}"
            Margin="0,0,0,18"
            Padding="8"/>

                            <TextBlock
    Text="{Binding StatusMessage}"
    Foreground="#4FC3F7"
    FontSize="13"
    TextWrapping="Wrap"
    Margin="0,10,0,15"/>

                            <Button
            Content="Save Audio Assignments"
            Command="{Binding SaveAssignmentsCommand}"
            HorizontalAlignment="Left"
            Padding="16,9"
            Background="#2488ED"
            Foreground="White"
            BorderBrush="#2488ED"/>

                        </StackPanel>

                    </Border>

                    <TextBlock
                        Text="Detected Playback Devices"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Margin="0,0,0,8"/>

                    <TextBlock
                        Text="{Binding StatusMessage}"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Margin="0,0,0,16"/>

                    <ItemsControl ItemsSource="{Binding AudioDevices}">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border
                                    Background="{DynamicResource SurfaceBrush}"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,10">

                                    <StackPanel>

                                        <TextBlock
                                            Text="{Binding Name}"
                                            FontSize="15"
                                            FontWeight="SemiBold"/>

                                        <TextBlock
                                            Text="{Binding Id}"
                                            FontSize="11"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            TextWrapping="Wrap"
                                            Margin="0,6,0,6"/>

                                        <TextBlock
                                            Text="Active"
                                            Foreground="LimeGreen"
                                            FontSize="12"/>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                    <Button
                        Content="↻  Refresh Audio Devices"
                        Command="{Binding RefreshDevicesCommand}"
                        HorizontalAlignment="Left"
                        Padding="16,9"
                        Margin="0,12,0,0"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
