<UserControl x:Class="VRA.App.Views.Pages.PatientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VRA.App.Controls">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ========================= -->
        <!-- Page Header               -->
        <!-- ========================= -->

        <controls:PageHeader
            Grid.Row="0"
            Title="Patients"
            Subtitle="Manage patient records">

            <controls:PageHeader.RightContent>

                <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <!-- New Patient -->
                    <Button
                        Content="+ New Patient"
                        Width="150"
                        Height="40"
                        Margin="0,0,8,0"
                        Command="{Binding NewPatientCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"/>

                    <Button
                        Content="Edit Patient"
                        Width="120"
                        Height="40"
                        Margin="0,0,8,0"
                        Command="{Binding EditPatientCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"/>

                    <!-- Search -->
                    <controls:SearchBox
                        Width="350"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                </StackPanel>

            </controls:PageHeader.RightContent>

        </controls:PageHeader>


        <!-- ========================= -->
        <!-- Patient DataGrid           -->
        <!-- ========================= -->

        <DataGrid
            Grid.Row="2"
            ItemsSource="{Binding PatientsView}"
            SelectedItem="{Binding SelectedPatient, Mode=TwoWay}">

            <DataGrid.Columns>

                <!-- Patient Name -->
                <DataGridTextColumn
                    Header="Patient"
                    Binding="{Binding FullName}"
                    Width="2*"/>

                <!-- IC / Passport -->
                <DataGridTextColumn
                    Header="IC / Passport"
                    Binding="{Binding IcPassportNumber}"
                    Width="1.5*"/>

                <!-- Date of Birth -->
                <DataGridTextColumn
                    Header="Date of Birth"
                    Binding="{Binding DateOfBirth, StringFormat={}{0:dd/MM/yyyy}}"
                    Width="1.2*"/>

                <!-- Age -->
                <DataGridTextColumn
                    Header="Age"
                    Binding="{Binding AgeDisplay}"
                    Width="0.8*"/>

                <!-- Guardian -->
                <DataGridTextColumn
                    Header="Guardian"
                    Binding="{Binding ParentGuardian}"
                    Width="1.5*"/>

                <!-- Diagnosis -->
                <DataGridTextColumn
                    Header="Diagnosis"
                    Binding="{Binding Diagnosis}"
                    Width="2*"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</UserControl>