<UserControl x:Class="VRA.App.Views.Pages.ReinforcementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <TextBlock Text="Visual Reinforcement Audiometry"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="0,0,0,6"/>

            <TextBlock Text="Control reinforcement displays and sound"
                       Opacity="0.7"
                       Margin="0,0,0,20"/>

            <!-- Patient information -->
            <Border Padding="16"
                    CornerRadius="10"
                    Margin="0,0,0,20"
                    Background="{DynamicResource CardBackgroundBrush}">
                <StackPanel>
                    <TextBlock Text="Current Patient"
                               FontSize="17"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding CurrentPatient.FullName,
                                              TargetNullValue='No patient selected'}"
                               FontSize="22"
                               Margin="0,8,0,4"/>

                    <TextBlock Text="{Binding StatusMessage}"
                               Opacity="0.75"/>
                </StackPanel>
            </Border>

            <Border Background="#292929"
        BorderBrush="#454545"
        BorderThickness="1"
        CornerRadius="10"
        Padding="16"
        Margin="0,0,0,20">

                <StackPanel>
                    <TextBlock Text="Reinforcement Status"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

                    <TextBlock Text="{Binding ActiveReinforcement,
                                  StringFormat='Active action: {0}'}"
                   FontSize="15"
                   Margin="0,0,0,6"/>

                    <TextBlock Text="{Binding ActiveTarget,
                                  StringFormat='Target display: {0}'}"
                   FontSize="15"
                   Margin="0,0,0,6"/>


                    <TextBlock Text="{Binding OutputState,
                          StringFormat='Output state: {0}'}"
                    FontSize="15"
                    Margin="0,0,0,6"/>


                    <TextBlock Text="{Binding HearingSessionStatus,
                          StringFormat='Hearing test session: {0}'}"
           FontSize="15"
           Margin="0,0,0,6"/>

                    <TextBlock Text="{Binding StatusMessage}"
                   Foreground="#70B7FF"
                   TextWrapping="Wrap"/>
                </StackPanel>
            </Border>


            <!-- Display selection -->
            <TextBlock Text="Select Display"
                       FontSize="19"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"/>


            <UniformGrid Columns="3" Margin="0,0,0,24">

                <Button Content="LEFT"
            Command="{Binding SelectDisplayCommand}"
            CommandParameter="Left"
            Margin="4"
            Padding="12">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#3A3A3A"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="#555555"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDisplay}"
                                 Value="Left">
                                    <Setter Property="Background" Value="#2488ED"/>
                                    <Setter Property="BorderBrush" Value="#2488ED"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="CENTRE"
            Command="{Binding SelectDisplayCommand}"
            CommandParameter="Centre"
            Margin="4"
            Padding="12">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#3A3A3A"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="#555555"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDisplay}"
                                 Value="Centre">
                                    <Setter Property="Background" Value="#2488ED"/>
                                    <Setter Property="BorderBrush" Value="#2488ED"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="RIGHT"
            Command="{Binding SelectDisplayCommand}"
            CommandParameter="Right"
            Margin="4"
            Padding="12">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#3A3A3A"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="#555555"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDisplay}"
                                 Value="Right">
                                    <Setter Property="Background" Value="#2488ED"/>
                                    <Setter Property="BorderBrush" Value="#2488ED"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </UniformGrid>


            <TextBlock Text="{Binding SelectedDisplay,
                                       StringFormat='Selected display: {0}'}"
                       FontSize="15"
                       Margin="0,0,0,20"/>

            <!-- Reinforcement controls -->
            <TextBlock Text="Reinforcement Controls"
                       FontSize="19"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"/>

            <UniformGrid Columns="2" Margin="0,0,0,12">


                <Button Content="▶  Show Animation"
        Command="{Binding ShowAnimationCommand}"
        Margin="4"
        Padding="16"
        FontSize="15"
        FontWeight="SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                    Background="#2488ED"
                    BorderBrush="#2488ED"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder"
                            Property="Background"
                            Value="#353535"/>
                                    <Setter TargetName="ButtonBorder"
                            Property="BorderBrush"
                            Value="#555555"/>
                                    <Setter Property="Foreground"
                            Value="#BDBDBD"/>
                                </Trigger>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder"
                            Property="Background"
                            Value="#1976D2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Foreground>White</Button.Foreground>
                </Button>





                <Button Content="🔊  Play Sound"
        Command="{Binding PlaySoundCommand}"
        Margin="4"
        Padding="16"
        FontSize="15"
        FontWeight="SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                    Background="#16834A"
                    BorderBrush="#16834A"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder"
                            Property="Background"
                            Value="#353535"/>
                                    <Setter TargetName="ButtonBorder"
                            Property="BorderBrush"
                            Value="#555555"/>
                                    <Setter Property="Foreground"
                            Value="#BDBDBD"/>
                                </Trigger>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder"
                            Property="Background"
                            Value="#116B3B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Foreground>White</Button.Foreground>
                </Button>


            </UniformGrid>

            <Button Content="■  STOP ALL"
                    Command="{Binding StopAllCommand}"
                    Background="#C83B3B"
                    Foreground="White"
                    FontWeight="Bold"
                    Padding="16"
                    Margin="4,0,4,20"/>

            <TextBlock Text="Hardware outputs are not connected yet."
                       Opacity="0.65"
                       FontStyle="Italic"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
