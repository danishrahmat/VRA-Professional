<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BackgroundColor">#202124</Color>
    <Color x:Key="SurfaceColor">#2D2D30</Color>
    <Color x:Key="PrimaryColor">#00AEEF</Color>
    <Color x:Key="SuccessColor">#00C853</Color>
    <Color x:Key="WarningColor">#FF9800</Color>
    <Color x:Key="ErrorColor">#F44336</Color>

    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#BDBDBD</Color>

</ResourceDictionary>